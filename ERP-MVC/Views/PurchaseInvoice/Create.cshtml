@using ERP_MVC.Models.DTOs.Purchasing
@model CreatePurchaseInvoiceDto

<div class="row mt-3">
    <div class="col-lg-10 mx-auto">
        <div class="card">
            <div class="card-body">

                <div class="d-flex justify-content-between mb-3">
                    <h5>Add New Purchase Invoice</h5>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="fa fa-arrow-left"></i> Back
                    </a>
                </div>

                <form asp-action="Create" method="post" id="invoice-form">
                    @Html.AntiForgeryToken()

                    <h6 class="text-muted mb-3">Invoice Information</h6>

                    <div class="row">
                        <div class="col-md-6">
                            <label>Supplier</label>
                            <select asp-for="SupplierId"
                                    asp-items="@(ViewBag.SupplierList as List<SelectListItem>)"
                                    class="form-control" required>
                                <option value="">-- Select Supplier --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label>Date</label>
                            <input asp-for="InvoiceDate" type="date" class="form-control" required />
                        </div>
                    </div>

                    <h6 class="text-muted mt-4 mb-2">Products</h6>

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th style="width:300px;">Product</th>
                                <th style="width:120px;">Qty</th>
                                <th style="width:120px;">Unit Price</th>
                                <th style="width:120px;">Total</th>
                                <th style="width:60px;">Action</th>
                            </tr>
                        </thead>

                        <tbody id="products-body">

                            <tr class="product-row" data-index="0">

                                <td>
                                    <select name="Items[0].ProductPackageId"
                                            class="form-control product-package-select"
                                            required>
                                        <option value="">Select Package</option>
                                    </select>
                                </td>

                                <td>
                                    <input name="Items[0].Quantity"
                                           type="number"
                                           class="form-control quantity"
                                           min="1"
                                           value="1"
                                           required />
                                </td>

                                <td>
                                    <input name="Items[0].UnitPrice"
                                           type="number"
                                           class="form-control price"
                                           min="0"
                                           step="0.01"
                                           value="0"
                                           required />
                                </td>

                                <td>
                                    <input class="form-control total"
                                           readonly
                                           value="0.00" />
                                </td>

                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-danger btn-sm remove-row">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>

                            </tr>

                        </tbody>
                    </table>

                    <button type="button" id="add-product" class="btn btn-outline-primary">
                        + Add Product
                    </button>

                    <h6 class="text-muted mt-4">Totals</h6>

                    <div class="row">

                        <div class="col-md-4">
                            <label>Total</label>
                            <input id="total-amount-display"
                                   class="form-control"
                                   readonly value="0.00" />
                        </div>

                        <div class="col-md-4">
                            <label>Discount</label>
                            <input asp-for="Discount"
                                   id="discount"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control"
                                   value="0" />
                        </div>

                        <div class="col-md-4">
                            <label>Net</label>
                            <input id="net-amount-display"
                                   class="form-control"
                                   readonly value="0.00" />
                        </div>

                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label>Payment Order Amount (optional)</label>
                            <input asp-for="PaymentOrderAmount"
                                   class="form-control"
                                   type="number"
                                   value="0"
                                   step="0.01" />
                        </div>
                    </div>

                    <div class="mt-4 d-flex justify-content-end">
                        <button class="btn btn-success px-5">
                            <i class="fa fa-check me-2"></i> Create Invoice
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<script src="~/js/product-selector.js"></script>