@using ERP_MVC.Models.DTOs.Purchasing
@model IEnumerable<PurchaseReturnListItemDto>

@{
    ViewData["Title"] = "Purchase Returns";
}

<div class="col-lg-12 mx-auto products-list">
    <div class="card">
        <div class="card-body">
            <div class="row g-2 add-item-button mb-3">
                <div class="col-md-6">
                    <h5 class="card-title product-list-title">Purchase Returns</h5>
                </div>
                <div class="col-md-6 text-end">
                    <a asp-controller="PurchaseReturn" asp-action="Create" class="btn btn-light px-5">
                        <i class="fa-solid fa-plus"></i> Add Return
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Supplier</th>
                            <th scope="col">Return Date</th>
                            <th scope="col">Total Amount</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int counter = 1;
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <th scope="row">@counter</th>
                                    <td>@item.SupplierName</td>
                                    <td>@item.ReturnDate.ToString("yyyy-MM-dd")</td>
                                    <td>@item.TotalAmount.ToString("N2")</td>
                                    <td>
                                        <div class="product-actions">
                                            <a asp-controller="PurchaseReturn" asp-action="Details" asp-route-id="@item.Id" title="View Details">
                                                <i class="fa-solid fa-eye text-primary"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                counter++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No returns found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>