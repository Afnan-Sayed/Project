@using ERP_MVC.Models.DTOs.Purchasing
@model PurchaseReturnResponseDto

@{
    ViewData["Title"] = "Purchase Return Details";
}

<div class="col-lg-10 mx-auto">
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Purchase Return Details</h5>
            <div>
                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
        <hr />
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="text-muted small">Return ID</label>
                    <p class="fw-bold">#@Model.Id</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Return Date</label>
                    <p class="fw-bold">@Model.ReturnDate.ToString("yyyy-MM-dd")</p>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="text-muted small">Supplier</label>
                    <p class="fw-bold">@Model.SupplierName</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Total Amount</label>
                    <p class="fw-bold text-danger">@Model.TotalAmount.ToString("N2")</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Reason))
            {
                <div class="row mb-4">
                    <div class="col-md-12">
                        <label class="text-muted small">Reason for Return</label>
                        <p class="fw-bold">@Model.Reason</p>
                    </div>
                </div>
            }

            <h6 class="text-uppercase text-body text-xs font-weight-bolder mb-3 mt-4">Returned Items</h6>

            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Product Name</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            int counter = 1;
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@counter</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice.ToString("N2")</td>
                                    <td>@item.Total.ToString("N2")</td>
                                </tr>
                                counter++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No items found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row mt-4">
                <div class="col-md-12">
                    <div class="card bg-light">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="text-muted mb-0">Grand Total</label>
                                <h4 class="text-danger mb-0">@Model.TotalAmount.ToString("N2")</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>